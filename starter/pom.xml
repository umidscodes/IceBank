<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ice Bank starter test project.

  One Maven module with API (REST Assured), DB (JDBC) and UI (Selenium) tests for Ice Bank.
  Everything lives in src/test: this project only contains tests and the helpers they use.

  Common commands (from the starter/ folder):
    mvn test                         all tests except the "destructive" tag, against -Denv=local
    mvn test -Dgroups=api            only @Tag("api") tests (also db, ui)
    mvn test -Denv=qa                the same suite against QA (fill in config/qa.properties first)
    mvn allure:serve                 open the Allure report in a browser (after mvn test)
  Windows PowerShell: quote every -D flag, for example  mvn test "-Denv=qa" "-Dgroups=api"
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.icebank</groupId>
    <artifactId>icebank-tests</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Ice Bank tests (starter)</name>

    <properties>
        <!-- Compile for Java 17 so the project works on JDK 17 and JDK 21. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- There is no src/main: everything is test code. -->
        <maven.main.skip>true</maven.main.skip>

        <!-- Which config/{env}.properties file to load: local (default) or qa. Override with -Denv=qa. -->
        <env>local</env>
        <!-- Tests tagged "destructive" (reset, clock) are skipped unless you clear this: -DexcludedGroups= -->
        <excludedGroups>destructive</excludedGroups>

        <!-- Library versions (pinned, checked against Maven Central) -->
        <junit.version>5.14.4</junit.version>
        <rest-assured.version>5.5.7</rest-assured.version>
        <jackson.version>2.22.4</jackson.version>
        <assertj.version>3.27.7</assertj.version>
        <selenium.version>4.52.0</selenium.version>
        <postgresql.version>42.7.14</postgresql.version>
        <allure.version>2.35.5</allure.version>
        <aspectj.version>1.9.27</aspectj.version>
        <slf4j.version>2.0.20</slf4j.version>
        <logback.version>1.6.6</logback.version>

        <!-- Plugin versions -->
        <surefire.version>3.6.1</surefire.version>
        <compiler-plugin.version>3.14.1</compiler-plugin.version>
        <resources-plugin.version>3.5.0</resources-plugin.version>
        <allure-maven.version>2.18.0</allure-maven.version>
        <allure-commandline.version>2.46.1</allure-commandline.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Test runner -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- REST API testing -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JSON to Java objects (records), with java.time support -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Fluent assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Browser automation -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Database (JDBC driver) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Reporting -->
        <!-- allure-jupiter is the current name of allure-junit5 (same library; the old name is relocated here). -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Declared so Maven downloads the agent jar that surefire's argLine points at. -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Logging: SLF4J API + Logback implementation (configured in src/test/resources/logback-test.xml) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${resources-plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- The AspectJ agent makes Allure's @Step and Allure.step(...) work.
                         The quotes keep it working when the Maven repository path contains spaces (Windows). -->
                    <argLine>
                        "-javaagent:${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                    <!-- groups / excludedGroups come from -Dgroups=... and the excludedGroups property above. -->
                    <excludedGroups>${excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <env>${env}</env>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                    <!-- Show the reason for a failure in the console, not only in target/surefire-reports. -->
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>

            <!-- mvn allure:report  -> target/site/allure-maven-plugin/index.html
                 mvn allure:serve   -> builds the report in a temp folder and opens it in a browser -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <configuration>
                    <reportVersion>${allure-commandline.version}</reportVersion>
                    <resultsDirectory>allure-results</resultsDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
