# Optional overrides. Defaults work out of the box for local development.
# PORT=3000
# DB_PORT=5433
# JWT_SECRET=local-dev-jwt-secret-change-me
# JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
# CARD_ENCRYPTION_KEY=local-dev-card-key-change-me
# PERF_MODE=true          # disables rate limits and the "Processing" delay, for JMeter
# DATABASE_URL=postgres://icebank_app:icebank_app@localhost:5433/icebank   # use your own Postgres instead of the embedded one
